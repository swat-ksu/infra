# Minimal dex environment example for our use case 

# GitHub OAuth app (https://github.com/organizations/swat-ksu/settings/applications)
# Callback URL must match redirectURI in config.yml
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret for the "outline" static client. Must match OIDC_CLIENT_SECRET in outline/.env
# Generate with: openssl rand -hex 32
OIDC_CLIENT_SECRET=